# App
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/nomei_db?retryWrites=true&w=majority
MONGODB_DB_NAME=nomei_db

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=teste@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM_EMAIL=teste@gmail.com
SMTP_FROM_NAME=noMEI

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (usado no link do e-mail de reset de senha)
# Em produção, aponte para a URL pública do app/web (ex: https://app.nomei.com.br)
FRONTEND_URL=http://localhost:3000